{
  "name": "ken-api-mcp",
  "version": "1.0.0",
  "description": "MCP server for Ken Video API - provides LLMs with comprehensive video processing capabilities",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm publish --access public"
  },
  "keywords": [
    "mcp",
    "video-processing",
    "ai",
    "automation",
    "n8n",
    "ffmpeg",
    "video-api",
    "captions",
    "voice-over",
    "railway"
  ],
  "author": "Ken <ken@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ken/ken-api-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ken/ken-api-mcp/issues"
  },
  "homepage": "https://github.com/ken/ken-api-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "axios": "^1.11.0",
    "form-data": "^4.0.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "ken-api-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
